# ─── Database ────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=ai_readonly
MYSQL_PASSWORD=readonly_password123
MYSQL_DATABASE=ai_assistant_demo
MYSQL_ROOT_PASSWORD=rootpassword123

# Admin connection (for schema inspection only)
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=rootpassword123

# ─── ChromaDB ────────────────────────────────────────────
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
CHROMA_COLLECTION_NAME=documents

# ─── Ollama ──────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ─── Backend ─────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Storage ─────────────────────────────────────────────
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,txt,csv,md,json

# ─── Security ────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret-key-in-production
SQL_QUERY_TIMEOUT=30
SQL_ROW_LIMIT=1000
SQL_RESULT_SIZE_LIMIT_MB=10

# ─── MCP Server ──────────────────────────────────────────
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8090

# ─── Embedding Model ─────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=5
