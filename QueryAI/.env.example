# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=QueryAI
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-secure-random-secret-in-production

# ─── PostgreSQL — App Metadata (history, conversations, schema cache) ─────────
APP_DATABASE_URL=postgresql://queryai_app:queryai_pass@localhost:5432/queryai_meta

# ─── PostgreSQL — Business / Analytics Database ───────────────────────────────
BUSINESS_DATABASE_URL=postgresql://queryai_readonly:queryai_readonly_pass@localhost:5432/queryai_demo
BUSINESS_DB_SCHEMA=public

# ─── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMADB_HOST=localhost
CHROMADB_PORT=8001
CHROMADB_COLLECTION=queryai_schema

# ─── Security ─────────────────────────────────────────────────────────────────
SQL_QUERY_TIMEOUT=30
SQL_MAX_ROWS=1000
SQL_MAX_RETRIES=2
RATE_LIMIT_PER_MINUTE=60

# ─── Backend ──────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
